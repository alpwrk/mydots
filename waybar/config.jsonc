{
  // Bar: flat black strip on top, white JetBrainsMono, no icons except
  // what the modules themselves print. Styling lives in style.css.

  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 30,

  // --- Module layout ---
  // Left: workspaces | Center: window title | Right: tray drawer, battery, volume, clock
  "modules-left": [
    //"custom/omarchy",
    //"custom/sep",
    "sway/workspaces",
    "custom/blank"
  ],

  "modules-center": [
    "sway/window"
  ],

  "modules-right": [
    "group/traydrawer",
    "custom/batstats",
    "pulseaudio",
    "clock"
  ],

  // --- Left side ---

  // Disabled for now, kept in case I want the launcher button back.
  // λ opens rofi (Super+D), right click opens a terminal.
  "custom/omarchy": {
    "format": "λ",
    "on-click": "rofi -m -1 -show drun",
    "on-click-right": "ghostty",
    "tooltip": true,
    "tooltip-format": "App Launcher\nSuper + D"
  },

  "sway/workspaces": {
    "on-click": "activate",
    // Roman numerals instead of the usual dots
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "6": "VI",
      "7": "VII",
      "8": "VIII",
      "9": "IX",
      "10": "X"
    },
    // Workspaces 1-5 always visible, empty ones dimmed in style.css
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },

  // Spacer after the last workspace
  "custom/blank": {
    "format": " ",
    "tooltip": false
  },

  "sway/window": {
    "format": "{title}",
    "max-length": 60,
    "tooltip": false
  },

  // --- Right side ---

  // Tray collapses into this drawer; hovering it slides the modules inside out
  // to the left (see transition-left-to-right). The arrow itself is styled
  // invisible in style.css and only the padding keeps the drawer closed.
  "group/traydrawer": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false,
      "children-class": "traydrawer-item"
    },
    "modules": [
      "custom/trayarrow",
      "tray",
      "custom/notification-silencing-indicator",
      "network",
      "bluetooth"
    ]
  },

  // "<" as HTML entity since waybar formats are Pango markup
  "custom/trayarrow": {
    "format": "&lt;",
    "tooltip": true,
    "tooltip-format": "Tray Icons"
  },

  "tray": {
    "icon-size": 13,
    "spacing": 6
  },

  // Battery status via the external script, because the built-in battery
  // module can't tell "plugged in and full" apart from "charging".
  // Signal 3 is sent from batstats.sh's udev rule partner (or manually
  // via pkill -SIGRTMIN+3 waybar) for instant updates.
  "custom/batstats": {
    "exec": "~/.config/waybar/batstats.sh",
    "interval": 5,
    "signal": 3,
    "tooltip": false
  },

  "pulseaudio": {
    "format": "󰕾 {volume}% ",
    "format-muted": "󰝟 MUTE ",
    "tooltip-format": "Playing at {volume}%",
    // Scroll changes volume in 5% steps
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "format-icons": {
      "default": ["", "", ""]
    }
  },

  // Left click shows date, format-alt switches back on the next click
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%e %B %A}",
    "tooltip": false
  },

  // --- Inside the tray drawer ---

  "network": {
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰌘",
    "format-disconnected": "󰤮",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "interval": 3,
    "spacing": 1,
    "on-click": "nm-connection-editor",
    "tooltip": false
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "blueman-manager"
  },

  // Unused (custom/batstats replaces it), kept as reference for the
  // waybar built-in module in case the script ever gets dropped.
  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-full": "󰂅",
    "interval": 5,
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    }
  },

  // Bell with a slash when mako is in do-not-disturb mode.
  // Click toggles the mode, signal 10 refreshes it.
  "custom/notification-silencing-indicator": {
    "exec": "if makoctl mode | grep -q do-not-disturb; then echo '{\"text\":\"󰂛\",\"class\":\"active\"}'; else echo '{\"text\":\"󰂚\"}'; fi",
    "on-click": "makoctl mode -t do-not-disturb",
    "signal": 10,
    "return-type": "json"
  },

  // --- Spare parts, not in any modules-* list above ---
  // Update counter for Arch. Only shows a number when updates exist.
  "custom/update": {
    "format": "",
    "exec": "checkupdates 2>/dev/null | wc -l",
    "on-click": "ghostty -e checkupdates",
    "signal": 7,
    "interval": 21600
  },

  // Brackets and separators for decoration
  "custom/sep": {
    "format": "︱",
    "tooltip": false
  },

  "custom/bracr": {
    "format": "]",
    "tooltip": false
  },

  "custom/bracl": {
    "format": "[",
    "tooltip": false
  }
}